@implements IAsyncDisposable
@using FluxKnowledge.Application.IntegrationV1.Corpus
@using FluxKnowledge.Application.Ports
@using FluxKnowledge.Web.Components.Status
@inject ISourceVerificationStore VerificationStore
@inject NativeCorpusCommandService CorpusCommands

<section class="source-verification" aria-labelledby="verification-heading">
    <h2 id="verification-heading">Source updates</h2>
    <p>Journal and watcher events select files to check. Weekly metadata reconciliation checks membership, size and modification time. Quiet, unchanged files are not reread.</p>
    <p>Files are checked using size and modification date. Unchanged files are not read again. Edits that preserve both values may be missed, including after a file event.</p>
    @if (CanonicalPath is not null)
    {
        <SourceJournalVolumeStatus CanonicalPath="@CanonicalPath" Scanning="_state.Status?.Scanning" />
    }
    @if (_state.ReadError is { } error) { <p role="alert">@error</p> }
    @if (_state.Status is { } status)
    {
        @if (status.Scanning is { } scanning)
        {
            <dl class="status-grid verification-grid">
                <div><dt>Recorded source coverage</dt><dd>@Coverage(scanning.Mode)</dd></div>
                <div><dt>Last metadata reconciliation attempt</dt><dd>@When(scanning.LastReconciliationAtUtc)</dd></div>
                <div><dt>Pending changes</dt><dd>@Count(scanning.PendingObligations)</dd></div>
                <div><dt>Saved journal lag (USN distance)</dt><dd>@(HasMeasuredLag(scanning) ? Count(scanning.DurableJournalLagUsn) : "Not measured")</dd></div>
                <div><dt>Namespace</dt><dd>@(scanning.NamespaceComplete ? "Complete" : "Metadata reconciliation pending")</dd></div>
            </dl>
            @if (scanning.UnresolvedThroughUsn is { } horizon)
            {
                <p>Namespace history remains unresolved through USN @Count(horizon).</p>
            }
            @if (scanning.NamespaceObligations > 0)
            {
                <p>Pending namespace reconciliation items: @Count(scanning.NamespaceObligations).</p>
            }
            @if (!scanning.NamespaceComplete || scanning.Mode == "JournalPartial")
            {
                <p>Journal access and a caught-up cursor can coexist with incomplete source coverage. Follow up on any <a href="#source-scan-issues-heading">path or read issues</a> and reconcile source metadata.</p>
            }
            @if (scanning.Reason is { } reason) { <p class="diagnostic-value">Change detection: @reason</p> }
        }
        @if (status.Run is { } run)
        {
            <details>
                <summary>Historical checksum verification: @run.State</summary>
                <p>Last complete verification: @When(status.LastVerifiedAtUtc). @Count(run.Verified) verified, @Count(run.Resolved) resolved, @Count(run.Deferred) deferred; @Count(run.Total) files in this cycle.</p>
                <p>@(run.ReadCountsIncomplete ? "At least" : "Recorded") @Count(run.SourceBytesRead) source bytes and @Count(run.RetainedBytesRead) retained bytes read.</p>
                @if (run.Reason is { } runReason) { <p class="diagnostic-value">Cycle status: @runReason</p> }
            </details>
        }
        <div class="verification-actions">
            @if (!ControlsDisabled && RootState == "Enabled" && status.Scanning?.PendingObligations > 0)
            {
                <GuidedRecoveryAction Action="source_sync" TargetId="RootId" SourceRootId="RootId" ActionLabel="Process pending changes" OnCommitted="RefreshAsync" />
            }
            <button type="button" disabled="@(ControlsDisabled || RootState != "Enabled")" @onclick="ReconcileAsync">Reconcile source metadata</button>
            <button type="button" disabled="@_refreshing" @onclick="RefreshAsync">Refresh source status</button>
        </div>
        @if (RootState != "Enabled")
        {
            <p>Metadata reconciliation is available when the source is enabled.</p>
        }
        else
        {
            <p>Metadata reconciliation queues a paced scan of the source inventory. Normal change checks determine which files need a content read.</p>
        }
        <p class="status-freshness">Reconciliation checks each included file's size and modification date and ingests new or changed files. Status refreshes every 10 seconds.</p>
    }
    else if (_state.ReadError is null) { <p role="status">Loading source status…</p> }
    @if (_state.Message is { } message) { <p role="status" aria-live="polite">@message</p> }
    @if (_state.HasPendingCommit) { <button type="button" disabled="@_state.IsSubmitting" @onclick="RetryAsync">Retry the same request</button> }
</section>
