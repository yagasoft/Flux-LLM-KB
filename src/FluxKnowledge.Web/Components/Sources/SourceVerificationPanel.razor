@implements IAsyncDisposable
@using FluxKnowledge.Application.IntegrationV1.Corpus
@using FluxKnowledge.Application.Ports
@inject ISourceVerificationStore VerificationStore
@inject NativeCorpusCommandService CorpusCommands

<section class="source-verification" aria-labelledby="verification-heading">
    <h2 id="verification-heading">Source updates</h2>
    <p>Journal and watcher events update changed files. Weekly metadata reconciliation checks membership, identity, size and modification time. Quiet, unchanged files are not reread.</p>
    <p>Automatic checksum verification is disabled. Changes with unchanged metadata may be missed if no event is available. Use a full rescan when you want every file read again.</p>
    @if (_state.ReadError is { } error) { <p role="alert">@error</p> }
    @if (_state.Status is { } status)
    {
        @if (status.Scanning is { } scanning)
        {
            <dl class="status-grid verification-grid">
                <div><dt>Change detection</dt><dd>@scanning.Mode</dd></div>
                <div><dt>Last metadata reconciliation attempt</dt><dd>@When(scanning.LastReconciliationAtUtc)</dd></div>
                <div><dt>Pending changes</dt><dd>@Count(scanning.PendingObligations)</dd></div>
                <div><dt>Journal lag (USN distance)</dt><dd>@Count(scanning.DurableJournalLagUsn)</dd></div>
                <div><dt>Namespace</dt><dd>@(scanning.NamespaceComplete ? "Complete" : "Metadata reconciliation pending")</dd></div>
            </dl>
            @if (scanning.Reason is { } reason) { <p class="diagnostic-value">Change detection: @reason</p> }
        }
        @if (status.Run is { } run)
        {
            <details>
                <summary>Historical checksum verification: @run.State</summary>
                <p>Last complete verification: @When(status.LastVerifiedAtUtc). @Count(run.Verified) verified, @Count(run.Resolved) resolved, @Count(run.Deferred) deferred; @Count(run.Total) files in this cycle.</p>
                <p>@(run.ReadCountsIncomplete ? "At least" : "Recorded") @Count(run.SourceBytesRead) source bytes and @Count(run.RetainedBytesRead) retained bytes read.</p>
                @if (run.Reason is { } runReason) { <p class="diagnostic-value">Cycle status: @runReason</p> }
            </details>
        }
        <div class="verification-actions">
            <button type="button" disabled="@(ControlsDisabled || RootState != "Enabled")" @onclick="FullRescanAsync">Full content rescan</button>
            <button type="button" disabled="@_refreshing" @onclick="RefreshAsync">Refresh source status</button>
        </div>
        <p class="status-freshness">A full content rescan reads every included file and reindexes changed content. Status refreshes every 10 seconds.</p>
    }
    else if (_state.ReadError is null) { <p role="status">Loading source status…</p> }
    @if (_state.Message is { } message) { <p role="status" aria-live="polite">@message</p> }
    @if (_state.HasPendingCommit) { <button type="button" disabled="@_state.IsSubmitting" @onclick="RetryAsync">Retry the same request</button> }
</section>
