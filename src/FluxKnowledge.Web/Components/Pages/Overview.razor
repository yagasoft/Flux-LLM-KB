@page "/"
@implements IAsyncDisposable
@using FluxKnowledge.Application.Contracts
@using FluxKnowledge.Web.Components.Status
@inject OverviewProjectionState ProjectionState
@inject StatusEventFeed StatusEvents

<PageTitle>Overview | Flux Knowledge</PageTitle>

<section aria-labelledby="overview-heading">
    <h1 id="overview-heading">Pipeline overview</h1>
    <p role="status" aria-live="polite">@_statusMessage</p>
    @{ var diagnostics = OverviewDiagnosticSummary.From(ProjectionState.Current.ActiveIndexGeneration, ProjectionState.Current.IndexRecovery); }
    <dl class="status-grid">
        <div><dt>Worker queued</dt><dd><StatusCount Value="ProjectionState.Current.WorkerQueuedCount" /></dd></div>
        <div><dt>Worker processing</dt><dd><StatusCount Value="ProjectionState.Current.WorkerProcessingCount" /></dd></div>
        <div><dt>GPU queued</dt><dd><StatusCount Value="ProjectionState.Current.GpuQueuedCount" /></dd></div>
        <div><dt>GPU processing</dt><dd><StatusCount Value="ProjectionState.Current.GpuProcessingCount" /></dd></div>
        <div><dt>Completed</dt><dd><StatusCount Value="ProjectionState.Current.CompletedCount" /></dd></div>
        <div><dt>Failed</dt><dd><StatusCount Value="ProjectionState.Current.FailedCount" /></dd></div>
        <div><dt>Indexed records</dt><dd><StatusCount Value="ProjectionState.Current.IndexedRecordCount" /></dd></div>
        <div><dt>Local source roots</dt><dd><StatusCount Value="ProjectionState.Current.SourceIndexing.RootCount" /></dd></div>
        <div><dt>Source deferred</dt><dd><StatusCount Value="ProjectionState.Current.SourceIndexing.DeferredCount" /></dd></div>
        <div><dt>Source blocked</dt><dd><StatusCount Value="ProjectionState.Current.SourceIndexing.BlockedCount" /></dd></div>
        <div><dt>Source errors</dt><dd><StatusCount Value="ProjectionState.Current.SourceIndexing.ErrorCount" /></dd></div>
        <div><dt>Outlook profiles</dt><dd><StatusCount Value="ProjectionState.Current.OutlookCapture.ProfileCount" /></dd></div>
        <div><dt>Outlook profiles enabled</dt><dd><StatusCount Value="ProjectionState.Current.OutlookCapture.EnabledProfileCount" /></dd></div>
        <div><dt>Outlook folders</dt><dd><StatusCount Value="ProjectionState.Current.OutlookCapture.FolderCount" /></dd></div>
        <div><dt>Outlook ingested</dt><dd><StatusCount Value="ProjectionState.Current.OutlookCapture.IngestedCount" /></dd></div>
        <div><dt>Outlook deferred</dt><dd><StatusCount Value="ProjectionState.Current.OutlookCapture.DeferredCount" /></dd></div>
        <div><dt>Outlook blocked</dt><dd><StatusCount Value="ProjectionState.Current.OutlookCapture.BlockedCount" /></dd></div>
        <div><dt>Index status</dt><dd>@diagnostics.State</dd></div>
        <div><dt>Index status reason</dt><dd>@diagnostics.Reason</dd></div>
        <div><dt>Recovery cleaned candidates</dt><dd><StatusCount Value="ProjectionState.Current.IndexRecovery.CleanedCandidateCount" /></dd></div>
    </dl>
    <details class="diagnostic-details">
        <summary>Copyable index diagnostics</summary>
        <label>Active generation <input class="diagnostic-value" readonly value="@diagnostics.ActiveGenerationDiagnostic" /></label>
        @if (diagnostics.RecoveryGenerationDiagnostic is { } recoveryGeneration)
        {
            <label>Recovery generation <input class="diagnostic-value" readonly value="@recoveryGeneration" /></label>
        }
        @if (ProjectionState.Current.IndexRecovery.LastCompletedAtUtc is { } lastCompletedAtUtc)
        {
            <p>Recovery last completed: @lastCompletedAtUtc.ToString("O")</p>
        }
        @if (ProjectionState.Current.IndexRecovery.NextRetryAtUtc is { } nextRetryAtUtc)
        {
            <p>Recovery next retry: @nextRetryAtUtc.ToString("O")</p>
        }
        @if (ProjectionState.Current.IndexRecovery.FailureCategory is { } failureCategory)
        {
            <p>Recovery failure category: @failureCategory</p>
        }
    </details>
</section>

<section aria-labelledby="gpu-scheduler-heading">
    <h2 id="gpu-scheduler-heading">Local GPU scheduler</h2>
    <p>Read-only local scheduler summary.</p>
    <dl class="status-grid">
        <div><dt>Scheduler ready</dt><dd><StatusCount Value="ProjectionState.Current.GpuSchedulerStatus.ReadyCount" /></dd></div>
        <div><dt>Scheduler active</dt><dd><StatusCount Value="ProjectionState.Current.GpuSchedulerStatus.ActiveCount" /></dd></div>
        <div><dt>Scheduler deferred</dt><dd><StatusCount Value="ProjectionState.Current.GpuSchedulerStatus.DeferredCount" /></dd></div>
        <div><dt>Scheduler outcome uncertain</dt><dd><StatusCount Value="ProjectionState.Current.GpuSchedulerStatus.OutcomeUncertainCount" /></dd></div>
        <div><dt>Scheduler slots available</dt><dd><StatusCount Value="ProjectionState.Current.GpuSchedulerStatus.AvailableSlotCount" /></dd></div>
        <div><dt>Scheduler slots reserved</dt><dd><StatusCount Value="ProjectionState.Current.GpuSchedulerStatus.ReservedSlotCount" /></dd></div>
        <div><dt>Scheduler slots uncertain</dt><dd><StatusCount Value="ProjectionState.Current.GpuSchedulerStatus.UncertainSlotCount" /></dd></div>
        <div><dt>Scheduler active batch</dt><dd>@(ProjectionState.Current.GpuSchedulerStatus.HasActiveBatch ? "Present" : "None")</dd></div>
        @if (ProjectionState.Current.GpuSchedulerStatus.ActiveBatchLane is { } activeBatchLane)
        {
            <div><dt>Scheduler active batch lane</dt><dd>@activeBatchLane</dd></div>
        }
        <div><dt>Scheduler next retry</dt><dd>@(ProjectionState.Current.GpuSchedulerStatus.NextDeferredAtUtc?.ToString("O") ?? "None")</dd></div>
        <div><dt>Scheduler uncertain capacity</dt><dd>@ProjectionState.Current.GpuSchedulerStatus.UncertainCapacity.State</dd></div>
        @if (ProjectionState.Current.GpuSchedulerStatus.UncertainCapacity.AgeMinutes is { } ageMinutes)
        {
            <div><dt>Scheduler uncertain capacity age</dt><dd>@ageMinutes minute(s)</dd></div>
        }
    </dl>
</section>

@code {
    private readonly CancellationTokenSource _stopping = new();
    private StatusEventSubscription? _subscription;
    private string _statusMessage = "Loading pipeline status…";

    protected override async Task OnInitializedAsync()
    {
        _subscription = await ProjectionState.SubscribeAndReloadAsync(StatusEvents, _stopping.Token);
        _statusMessage = "Pipeline status loaded.";
        _ = ObserveAsync(_subscription, _stopping.Token);
    }

    private async Task ObserveAsync(StatusEventSubscription subscription, CancellationToken cancellationToken)
    {
        try
        {
            await foreach (var statusChanged in subscription.Reader.ReadAllAsync(cancellationToken))
            {
                await ProjectionState.HandleStatusChangedAsync(statusChanged, cancellationToken);
                _statusMessage = "Pipeline status updated.";
                await InvokeAsync(StateHasChanged);
            }
        }
        catch (OperationCanceledException) when (cancellationToken.IsCancellationRequested)
        {
        }
    }

    public async ValueTask DisposeAsync()
    {
        await _stopping.CancelAsync();
        if (_subscription is not null)
        {
            await _subscription.DisposeAsync();
        }
        _stopping.Dispose();
    }
}
