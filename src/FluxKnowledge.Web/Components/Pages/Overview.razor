@page "/"
@attribute [StreamRendering]
@implements IAsyncDisposable
@using System.Globalization
@using FluxKnowledge.Application.Contracts
@using FluxKnowledge.Web.Components.Status
@using Microsoft.Extensions.Logging
@inject OverviewProjectionState ProjectionState
@inject IProjectionReader ProjectionReader
@inject StatusEventFeed StatusEvents
@inject GuidedRecoveryActions GuidedActions
@inject ILogger<Overview> AttentionLogger

<PageTitle>Overview | Flux Knowledge</PageTitle>
@{
    var activity = ProjectionState.Current.Activity;
    var view = PipelineActivityView.From(activity, SelectedRoot);
    var global = PipelineActivityView.From(activity);
    var diagnostics = OverviewDiagnosticSummary.From(ProjectionState.Current.ActiveIndexGeneration, ProjectionState.Current.IndexRecovery);
    var scheduler = ProjectionState.Current.GpuSchedulerStatus;
    var outlook = ProjectionState.Current.OutlookCapture;
    var stages = activity.FileStages.Where(s => SelectedRoot is null || s.SourceRootId == SelectedRoot)
        .GroupBy(s => new { s.Stage, s.State }).Select(g => new { g.Key.Stage, g.Key.State, Count = g.Sum(s => s.Count) }).ToArray();
    var ocrDemand = activity.OcrDemand.Where(s => SelectedRoot is null || s.SourceRootId == SelectedRoot).ToArray();
    var runningTasks = activity.RunningTasks.Where(t => SelectedRoot is null || t.SourceRootId == SelectedRoot).ToArray();
    var existingRecoveries = view.Jobs.Where(j => !j.IsHistorical && RecoveryExplanation(j.Reason) is not null &&
        j.State is PipelineWorkState.Waiting or PipelineWorkState.Queued or PipelineWorkState.Running).ToArray();
    var foregroundResultCount = SelectedRoot is null ? activity.GpuTasks.Where(g => g.IsInteractive && g.State == "Outcome uncertain").Sum(g => g.Count) : 0;
    var submitted = GuidedActions.Recent(SelectedRoot).Where(attempt =>
        (attempt.Target.Action != "root_resume" || ProjectionState.IsStale ||
         !view.Sources.Any(source => source.Id == attempt.Target.TargetId && source.Lifecycle == "Paused")) &&
        (ProjectionState.IsStale || !(_attention?.Items.Any(item => item.Id == attempt.Target.TargetId && item.Applicability == "Current" &&
            item.State == "Failed" && item.Stage is "Publish" or "Embed") ?? false))).ToArray();
    var refreshContext = ProjectionState.HasSnapshot
        ? "The last successful read is shown below and may be out of date."
        : "Current activity is unavailable; zero activity has not been confirmed.";
}
<div class="pipeline-overview">
    <header class="overview-header">
        <h1>Overview</h1>
        <div class="overview-scope">
        <label class="source-scope">Source scope
            <select @bind="_sourceScope" @bind:after="ScopeChangedAsync" disabled="@(!activity.IsAvailable)">
                <option value="">All sources and app activity</option>
                @foreach (var source in activity.Sources)
                {
                    <option value="@source.Id">@source.Name (@source.Lifecycle)</option>
                }
            </select>
        </label>
            <button type="button" @onclick="RefreshAsync">Refresh status</button>
        </div>
    </header>
    <p class="visually-hidden" role="status" aria-live="polite">@_announcement</p>
    @if (ProjectionState.IsStale)
    {
        <p class="pipeline-warning refresh-notice" role="alert">@ProjectionState.RefreshIssue @refreshContext</p>
    }
    @if (ProjectionState.LastSuccessfulReadAtUtc is { } observed)
    {
        <p class="status-freshness">Status as of <time datetime="@observed.ToString("O")">@Time(observed)</time></p>
    }
    @if (activity.IsAvailable)
    {
        <section class="overview-status" aria-label="Search and indexing status">
            <div class="overview-status-heading">
                <div><div class="overview-status-title">
                    <span class="overview-title-reserve" aria-hidden="true">Latest status is unavailable</span>
                    <h2>@(ProjectionState.IsStale ? "Latest status is unavailable" : diagnostics.State == "Healthy" ? "Search index is ready" : $"Search index is {diagnostics.State.ToLowerInvariant()}")</h2>
                    </div><p>@view.State · @view.Message</p></div>
                <a class="operation-link" href="/search">Search</a>
            </div>
            <dl class="overview-metrics">
                <div><dt>Searchable files</dt><dd><StatusCount Value="view.PublishedFiles" /></dd></div>
                <div><dt>Files awaiting indexing</dt><dd><StatusCount Value="view.PendingFiles" /></dd></div>
                <div><dt>Blocked or failed files</dt><dd><StatusCount Value="@(view.BlockedFiles + view.FailedFiles)" /></dd></div>
            </dl>
        </section>
    }
    @foreach (var source in view.Sources.Where(s => s.JournalHealth is { IsUnavailable: true } or { RecoveryRequired: true } or { Mode: "JournalPartial" }))
    {
        <SourceJournalWarning Source="source" />
    }
    <section id="pipeline-attention" aria-labelledby="attention-heading">
        <h2 id="attention-heading" tabindex="-1" @ref="_attentionHeading">Needs attention</h2>
        @if (!activity.IsAvailable)
        {
            <p>Current issues are unavailable. Refresh status to check for blockers.</p>
        }
        else
        {
            var causes = activity.FileCauses.Where(c => SelectedRoot is null || c.SourceRootId == SelectedRoot)
                .OrderByDescending(c => c.Count).ThenBy(c => c.Reason, StringComparer.Ordinal).ToArray();
            var causeCards = causes.GroupBy(c => (c.SourceRootId, c.Category, Title: IssueTitle(c)))
                .OrderByDescending(group => group.Sum(c => c.Count));
            var pausedSources = view.Sources.Where(s => s.Lifecycle == "Paused").ToArray();
            var issuesVisible = causes.Length > 0 || pausedSources.Length > 0 ||
                view.BlockedFiles > 0 || view.FailedFiles > 0 || view.ProvisionalFiles > 0 ||
                view.AttentionJobs > 0 || view.UncertainGpuTasks > 0 || view.UnconfirmedGpuTasks > 0 ||
                view.Sources.Any(s => s.ScanErrors > 0 || s.UnconfirmedControls > 0 || s.LifecycleReason is not null) ||
                diagnostics.State == "Blocked" || SelectedRoot is null && outlook.BlockedCount > 0 ||
                activity.UncertainCapacitySlots > 0 && SelectedRoot is null;
            @if (!issuesVisible)
            {
                <p>No current blockers in this sample.</p>
            }
            <div class="issue-workspace @(_filesOpen ? "has-selection" : null)">
            <div class="issue-list-panel">
            <ul class="issue-list">
                @foreach (var group in causeCards)
                {
                    var count = group.Sum(c => c.Count);
                    var single = group.Count() == 1 ? group.First() : null;
                    var sourceName = view.Sources.FirstOrDefault(s => s.Id == group.Key.SourceRootId)?.Name ?? "Source unavailable";
                    var filter = CurrentFiles(group.Key.Category, single?.Reason);
                    <li class="issue-row" @key="group.Key">
                        <div>
                            <h3>@group.Key.Title</h3>
                            <p>@(single?.NextAction ?? "Review the reasons and suggested actions for these files.")</p>
                            <small>@FormatCount(count, "file") · @sourceName</small>
                        </div>
                        <button type="button" @onclick="() => LoadFilesAsync(filter, group.Key.SourceRootId, single?.Count)">Review files</button>
                    </li>
                }
                @foreach (var source in pausedSources)
                {
                    <li class="issue-row" @key="source.Id">
                        <div><h3>Indexing is paused</h3><p>Changes to this source will wait until indexing resumes.</p><small>@source.Name</small></div>
                        <div>
                            @if (!ProjectionState.IsStale)
                            {
                                <GuidedRecoveryAction Action="root_resume" TargetId="source.Id" SourceRootId="source.Id" ActionLabel="Resume indexing" OnCommitted="RefreshAsync" />
                            }
                            <a href="@($"/sources/{source.Id}")">Source details</a>
                        </div>
                    </li>
                }
                @foreach (var source in view.Sources.Where(s => s.ScanErrors > 0 || s.UnconfirmedControls > 0 || s.LifecycleReason is not null))
                {
                    <li class="issue-row">
                        <div><h3>Source activity needs review</h3><p>@SourceIssueSummary(source)</p><small>@source.Name</small></div>
                        <a class="operation-link" href="@($"/sources/{source.Id}")">Review source</a>
                    </li>
                }
                @if (diagnostics.State == "Blocked")
                {
                    <li class="issue-row">
                        <div><h3>Search index recovery is blocked</h3><p>@diagnostics.Reason</p></div>
                        <a class="operation-link" href="#index-health-heading">Review index health</a>
                    </li>
                }
                @if (SelectedRoot is null && outlook.BlockedCount > 0)
                {
                    <li class="issue-row">
                        <div><h3>Outlook capture needs review</h3><p>Check the selected folders, companion status and catch-up options.</p><small>@FormatCount(outlook.BlockedCount, "blocked export")</small></div>
                        <a class="operation-link" href="/outlook">Review Outlook capture</a>
                    </li>
                }
                @if (view.AttentionJobs > 0)
                {
                    <li class="issue-row">
                        <div><h3>Indexing work needs review</h3><p>Check failed steps, unconfirmed claims and cleanup that still needs verification.</p><small>@FormatCount(view.AttentionJobs, "job")</small></div>
                        <button type="button" @onclick='() => LoadAttentionAsync("current-jobs", 0)'>Review current jobs</button>
                    </li>
                }
                @if (view.UncertainGpuTasks + view.UnconfirmedGpuTasks > 0 || SelectedRoot is null && activity.UncertainCapacitySlots > 0)
                {
                    <li class="issue-row">
                        <div><h3>GPU work needs verification</h3><p>Check the recorded result and whether the GPU resources were released.</p>
                            <small>@view.UncertainGpuTasks GPU tasks with uncertain outcomes · @view.UnconfirmedGpuTasks claims to verify</small>
                            @if (foregroundResultCount > 0) { <p>@FormatCount(foregroundResultCount, "attempt") came from interactive search. Earlier search requests are never replayed.</p> }</div>
                        <button type="button" @onclick='() => LoadAttentionAsync("current-gpu", 0)'>Check GPU evidence</button>
                    </li>
                }
                @if (view.ProvisionalFiles > 0)
                {
                    <li class="issue-row">
                        <div><h3>Files waiting for source verification</h3><p>Indexing will use the confirmed revision after source reconciliation.</p><small>@FormatCount(view.ProvisionalFiles, "file")</small></div>
                        <button type="button" @onclick='() => LoadFilesAsync(CurrentFiles("Unconfirmed"), SelectedRoot, view.ProvisionalFiles)'>Review files</button>
                    </li>
                }
            </ul>
            <div class="issue-actions file-issue-toolbar">
                @if (view.BlockedFiles > 0) { <button type="button" @onclick='() => LoadFilesAsync(CurrentFiles("Blocked"), SelectedRoot, view.BlockedFiles)'>Review @FormatCount(view.BlockedFiles, "blocked file")</button> }
                @if (view.FailedFiles > 0) { <button type="button" @onclick='() => LoadFilesAsync(CurrentFiles("Failed"), SelectedRoot, view.FailedFiles)'>Review @FormatCount(view.FailedFiles, "failed file")</button> }
                <button type="button" @onclick="ShowIgnoredFilesAsync">Ignored files and rules@(view.IgnoredFiles > 0 ? $" ({view.IgnoredFiles:N0})" : null)</button>
            </div>
            </div>
            <div class="issue-inspector" hidden="@(!_filesOpen)">
                <button class="inspector-close" type="button" @onclick="CloseFilesAsync">Close file details</button>
                <PipelineFileExplorer @ref="_fileExplorer" SourceRootId="@SelectedRoot" Sources="@activity.Sources" ActionsEnabled="@(!ProjectionState.IsStale)" PreferencesChanged="RefreshAsync" />
            </div>
            </div>
            <details class="diagnostic-details overview-disclosure"><summary>Previous attempts</summary>
                <p>@view.HistoricalJobs historical pipeline jobs and @view.HistoricalGpuTasks historical GPU attempts. Earlier records can help explain an interruption.</p>
                <p>When file removal is confirmed, FluxKnowledge retires queued work automatically. The job history keeps the result. Worker or GPU cleanup that still needs verification appears under Needs attention.</p>
                <p class="issue-actions"><button type="button" @onclick='() => LoadAttentionAsync("historical-jobs", 0)'>View previous jobs</button>
                    <button type="button" @onclick='() => LoadAttentionAsync("historical-gpu", 0)'>View previous GPU attempts</button></p>
            </details>
            <details class="diagnostic-details overview-disclosure"><summary>Job and GPU diagnostics</summary>
                <p class="issue-actions"><button type="button" @onclick='() => LoadAttentionAsync("jobs", 0)'>View pipeline job records</button>
                    <button type="button" @onclick='() => LoadAttentionAsync("gpu", 0)'>View GPU task records</button> <a href="/operator-actions">Review processor actions</a></p>
            </details>
        }
        @if (_attentionError is not null) { <p role="alert">@_attentionError</p> }
        @if (_attention is { } attention)
        {
            <h3 id="attention-records-heading" tabindex="-1" @ref="_attentionRecordsHeading">@AttentionRecordHeading</h3>
            @if (attention.Reasons.Count > 1)
            {
                <div class="reason-filters" role="group" aria-label="Filter records by reason">
                    <button type="button" aria-pressed="@AttentionPressed(null)" @onclick="() => LoadAttentionAsync(_attentionUnit, 0, null, false)">All reasons (@attention.Reasons.Sum(r => r.Count).ToString("N0"))</button>
                    @foreach (var reason in attention.Reasons)
                    {
                        <button type="button" @key="reason.Reason" aria-pressed="@AttentionPressed(reason.Reason)" @onclick="() => LoadAttentionAsync(_attentionUnit, 0, reason.Reason, false)">@reason.Label (@reason.Count.ToString("N0"))</button>
                    }
                </div>
            }
            else if (_attentionReason is not null && !attention.Reasons.Any(r => r.Reason == _attentionReason))
            {
                <button type="button" @onclick="() => LoadAttentionAsync(_attentionUnit, 0, null, false)">Clear reason filter</button>
            }
            else if (attention.Reasons.Count == 1)
            {
                <p class="file-reason-summary">@attention.Reasons[0].Label · @FormatCount(attention.Reasons[0].Count, "record")</p>
            }
            @if (attention.TotalCount == 0) { <p>No records match this view.</p> }
            <div class="table-scroll"><table>
                <caption>@attention.TotalCount @(_attentionUnit.EndsWith("jobs", StringComparison.Ordinal) ? "pipeline job" : "GPU task") records for @AttentionScopeLabel. Page @(attention.Page + 1). Loaded @Time(_attentionReadAtUtc).</caption>
                <thead><tr><th>Source</th><th>Unit / status</th><th>Applicability</th><th>Reason</th><th>Details</th></tr></thead>
                <tbody>
                    @foreach (var item in attention.Items)
                    {
                        <tr @key="item.Id"><td>@item.SourceName</td><td>@(item.Stage ?? item.Unit) · @item.State</td><td>@item.Applicability</td>
                            <td>@item.Reason
                                @if (item.ResultStatus is { } result) { <p>Result · @result</p> }
                                @if (item.CapacityStatus is { } capacity) { <p>GPU resources · @capacity</p> }
                            </td>
                            <td>@if (item.PipelineRecordId is { } recordId) { <a href="@($"/corpus/{recordId}")">View record</a> }
                                @if (!ProjectionState.IsStale && item.Applicability == "Current" && item.State == "Failed")
                                {
                                    @if (item.Stage == "Publish")
                                    { <GuidedRecoveryAction Action="publication_retry" TargetId="item.Id" PipelineRecordId="item.PipelineRecordId" ActionLabel="Retry publication" OnCommitted="RefreshAsync" /> }
                                    else if (item.Stage == "Embed")
                                    { <GuidedRecoveryAction Action="embedding_retry" TargetId="item.Id" PipelineRecordId="item.PipelineRecordId" ActionLabel="Retry embedding" OnCommitted="RefreshAsync" /> }
                                }
                                <details><summary>Diagnostic identity</summary><code>@item.Id</code><p>@(item.Unit == "Pipeline job" ? "Last attempt or source registration" : "GPU task created"): @Time(item.RecordedAtUtc)</p></details></td></tr>
                    }
                </tbody>
            </table></div>
            <p class="status-freshness">Record status is the retained pipeline label. Confirmed execution and current applicability are shown above.</p>
            <p><button type="button" disabled="@(attention.Page == 0)" @onclick="() => LoadAttentionAsync(_attentionUnit, attention.Page - 1, _attentionReason, false)">Previous records</button>
                <button type="button" disabled="@((attention.Page + 1) * attention.PageSize >= attention.TotalCount)" @onclick="() => LoadAttentionAsync(_attentionUnit, attention.Page + 1, _attentionReason, false)">Next records</button>
                <button type="button" @onclick="() => LoadAttentionAsync(_attentionUnit, attention.Page, _attentionReason, false)">Refresh records</button></p>
        }
    </section>
    @if (submitted.Length > 0)
    {
        <section aria-labelledby="requested-recovery-heading">
            <h2 id="requested-recovery-heading">Recovery requests</h2>
            <ul class="issue-list">
                @foreach (var attempt in submitted)
                {
                    <li class="issue-row" @key="attempt.Target">
                        <div><h3>@attempt.Label</h3><p>@(view.Sources.FirstOrDefault(s => s.Id == attempt.SourceRootId)?.Name ?? "Selected indexing work")</p></div>
                        <GuidedRecoveryAction Action="@attempt.Target.Action" TargetId="attempt.Target.TargetId" ActionLabel="@attempt.Label"
                                              ReconcileMetadata="attempt.Target.ReconcileMetadata" SourceRootId="attempt.SourceRootId"
                                              PipelineRecordId="attempt.PipelineRecordId" CanDismissReceipt="true" OnCommitted="RefreshAsync" />
                    </li>
                }
            </ul>
        </section>
    }
    @if (existingRecoveries.Length > 0 || activity.IsAvailable && diagnostics.State == "Recovering")
    {
        <section aria-labelledby="automatic-continuations-heading">
            <h2 id="automatic-continuations-heading">@(ProjectionState.IsStale ? "Automatic work in the last update" : "Continuing automatically")</h2>
            <ul class="issue-list">
                @foreach (var job in existingRecoveries)
                {
                    <li class="issue-row">
                        <div><h3>@RecoveryExplanation(job.Reason)</h3><small>@FormatCount(job.Count, "job") · @job.SourceName · @job.State</small></div>
                        <a class="operation-link" href="@(job.SourceRootId is { } root ? $"/events?source={root:D}" : "/events")">View activity</a>
                    </li>
                }
                @if (diagnostics.State == "Recovering")
                {
                    <li class="issue-row">
                        <div><h3>Search index recovery</h3><p>@diagnostics.Reason</p>
                            @if (ProjectionState.Current.IndexRecovery.NextRetryAtUtc is { } retryAt) { <small>Next scheduled attempt @Time(retryAt)</small> }</div>
                        <a class="operation-link" href="#index-health-heading">View index health</a>
                    </li>
                }
            </ul>
        </section>
    }
    <section aria-labelledby="source-progress-heading">
        <h2 id="source-progress-heading">Source progress</h2>
        <p>Known files include discovered files and retained archive members. The categories add up to Known files. Published — ready to query means the file's extracted text has completed indexing.</p>
        <details><summary>How files are counted</summary><p>Each logical file is a source root plus canonical path: physical paths are case-insensitive; archive member paths are case-sensitive. Generated text and metadata belong to their original file. Conflicting current revision bindings are unconfirmed, rather than selecting the newest timestamp.</p>
            <p>Pipeline jobs, GPU tasks, pages and passages are separate units. Undiscovered changes, interactive search and independent local ingress are outside these file totals. Archive entries skipped or deferred before retention are excluded; no logical file identity is known for them. The file outcome categories are mutually exclusive.</p>
            <p>No extractable text describes direct file text. An expanded archive does not publish direct text; its retained members have separate outcomes.</p></details>
        @if (activity.IsAvailable)
        { <p><strong>@view.PublishedFiles.ToString("N0", CultureInfo.GetCultureInfo("en-GB")) of @view.KnownFiles.ToString("N0", CultureInfo.GetCultureInfo("en-GB")) known files are ready to query</strong> in @(SelectedRoot is null ? "all configured sources" : "the selected source"). Counts belong to the committed sample timestamp above.</p> }
        <div class="source-progress-list">
            @foreach (var source in view.Sources)
            {
                <article class="source-progress-card" @key="source.Id">
                    <header><h3><a href="@($"/sources/{source.Id}")">@source.Name</a></h3><span>@source.Lifecycle</span></header>
                    <div class="source-progress-summary">
                        <p><strong>@source.PublishedFiles.ToString("N0", CultureInfo.GetCultureInfo("en-GB"))</strong> searchable</p>
                        <p><strong>@source.PendingFiles.ToString("N0", CultureInfo.GetCultureInfo("en-GB"))</strong> awaiting indexing</p>
                        <p><strong>@((source.BlockedFiles + source.FailedFiles).ToString("N0", CultureInfo.GetCultureInfo("en-GB")))</strong> blocked or failed</p>
                    </div>
                    <details><summary>File counts and path</summary><p class="source-path">@source.Path</p>
                    <dl class="source-file-counts">
                        <div><dt>Known files</dt><dd><button class="count-link" type="button" aria-label="@($"Known files: {source.KnownFiles:N0}")" @onclick='() => LoadFilesAsync(new("all"), source.Id, source.KnownFiles)'><StatusCount Value="source.KnownFiles" /></button></dd></div>
                        @foreach (var category in PipelineFilePresentation.Categories(source))
                        {
                            <div><dt>@category.Label</dt><dd><button class="count-link" type="button" aria-label="@($"{category.Label}: {category.Count:N0}")" @onclick="() => LoadFilesAsync(new(category.Category), source.Id, category.Count)"><StatusCount Value="category.Count" /></button></dd></div>
                        }
                    </dl>
                    </details>
                    @if (source.IsScanning)
                    {
                        <p>Checking this source for changes. The inventory is incomplete while the scan runs.</p>
                    }
                    @if (source.LastScanCompletedAtUtc is null)
                    { <p>No completed scan confirms this source's coverage; the known inventory may be incomplete.</p> }
                    @if (source.ProvisionalFiles > 0)
                    {
                        <p class="pipeline-warning">@source.ProvisionalFiles known files have unconfirmed revision bindings. Published and pending totals exclude these files until authoritative source reconciliation completes. <a href="@($"/sources/{source.Id}")">View source details</a></p>
                    }
                    @if (source.LifecycleReason is { } reason)
                    {
                        <p class="pipeline-warning">Source operation needs attention: @reason. <a href="@($"/sources/{source.Id}")">View source status</a></p>
                    }
                    <p class="status-freshness">Last successful scan: @Time(source.LastScanCompletedAtUtc). Last confirmed publication: @Time(source.LastProgressAtUtc).</p>
                    @if (source.ScanErrors > 0)
                    {
                        <p class="pipeline-warning">The latest scan reported @source.ScanErrors problems. Its inventory may be incomplete. <a href="@($"/sources/{source.Id}")">View source details</a></p>
                    }
                    @if (source.UnconfirmedControls > 0)
                    {
                        <p class="pipeline-warning">@source.UnconfirmedControls source scan or processor claims have unconfirmed leases. <a href="@($"/sources/{source.Id}")">View source status</a></p>
                    }
                    @if (source.DeferredFiles + source.MetadataOnlyFiles + source.CompletedWithoutTextFiles > 0)
                    {
                        <details><summary>Other file outcomes</summary><p>@source.DeferredFiles deferred files; @source.MetadataOnlyFiles files with metadata indexed; @source.CompletedWithoutTextFiles files processed without extractable text. These are not counted as published full-text files.</p></details>
                    }
                </article>
            }
        </div>
        @if (activity.IsAvailable && view.Sources.Count == 0)
        {
            <p>No source roots are configured in this scope. <a href="/sources">Sources and indexing</a></p>
        }
    </section>
    <section aria-labelledby="current-activity-heading" class="activity-banner" id="current-activity">
        <div class="activity-heading">
            <div><h2 id="current-activity-heading">Current activity</h2><p class="activity-state">@view.State</p></div>
            <a href="#pipeline-attention">Needs attention</a>
        </div>
        <p>@view.Message</p>
        @if (scheduler.OcrOwner is { } owner)
        {
            <aside class="ocr-capacity-status" aria-label="GPU capacity owner">
                <h3>@(owner.State == "Running" ? "OCR is using GPU capacity" : "OCR is holding GPU capacity")</h3>
                <p>@owner.State · @owner.Executor · Last heartbeat: @(owner.HeartbeatAgeMinutes?.ToString("N0", CultureInfo.GetCultureInfo("en-GB")) ?? "unknown") minutes ago.
                    @if (owner.DeadlineAtUtc is { } deadline) { <span>Execution deadline: @Time(deadline).</span> }</p>
                <p>@owner.NextAction @if (owner.State != "Running") { <a href="/operator-actions">Operator actions</a> }</p>
                <details><summary>Capacity diagnostics</summary><p>Reason: <code>@owner.ReasonCode</code></p>
                    <p>Batch: <code>@owner.BatchId</code> · Execution: <code>@(owner.ExecutionInstanceId?.ToString() ?? "Legacy owner unconfirmed")</code></p></details>
            </aside>
        }
        @if (activity.IsAvailable)
        {
            <p class="attention-summary"><a href="#pipeline-attention">Blocked files: @view.BlockedFiles · failed files: @view.FailedFiles · uncertain GPU tasks: @view.UncertainGpuTasks</a></p>
            <dl class="status-grid activity-counts">
                <div><dt>Running pipeline jobs</dt><dd><StatusCount Value="view.RunningJobs" /></dd></div>
                <div><dt>Queued pipeline jobs</dt><dd><StatusCount Value="view.QueuedJobs" /></dd></div>
                <div><dt>Waiting pipeline jobs</dt><dd><StatusCount Value="view.WaitingJobs" /></dd></div>
                <div><dt>Active GPU tasks</dt><dd><StatusCount Value="view.ActiveGpuTasks" /></dd></div>
            </dl>
            <p>@view.ReadyGpuTasks GPU tasks are ready; @view.WaitingGpuTasks GPU tasks await dispatch, retry or admission.</p>
            @if (SelectedRoot is null)
            {
                <p>@activity.ActiveScans source scans and @activity.ActiveProcessors retained processors have confirmed leases.</p>
            }
            else
            {
                <p class="status-freshness">Across the app: @global.ActiveGpuTasks active GPU tasks and @global.UncertainGpuTasks GPU tasks with uncertain outcomes. Interactive search and local ingress are included only in the all-sources view.</p>
            }
            @foreach (var source in view.Sources.Where(s => s.IsScanning || s.ActiveProcessors > 0 || s.ActiveSourceOperations > 0 || s.QueuedScans > 0 || s.WaitingScans > 0))
            {
                <p><strong>@source.Name</strong>: @(source.IsScanning ? "checking source changes; " : "")
                    @source.ActiveProcessors active retained processors; @source.ActiveSourceOperations active source operations @source.LifecyclePhase;
                    @source.QueuedScans queued source scans; @source.WaitingScans waiting source scans.</p>
            }
            @if (view.Jobs.Any(j => j.State is PipelineWorkState.Running or PipelineWorkState.Queued or PipelineWorkState.Waiting))
            {
                <ul class="activity-list">
                    @foreach (var job in view.Jobs.Where(j => j.State is PipelineWorkState.Running or PipelineWorkState.Queued or PipelineWorkState.Waiting))
                    {
                        <li><strong>@job.SourceName</strong> · @job.Stage · @job.State · @job.Count pipeline jobs. @(RecoveryExplanation(job.Reason) ?? job.Reason)</li>
                    }
                </ul>
            }
            <h3>Files behind running tasks</h3>
            @if (runningTasks.Length > 0)
            {
                <div class="running-task-list">
                    @foreach (var task in runningTasks)
                    {
                        <article class="running-task-row" @key="task.Id">
                            @if (string.IsNullOrWhiteSpace(task.FullPath)) { <strong>@task.SourceName</strong> }
                            else { <FilePath FullPath="@task.FullPath" ArchivePath="@task.ArchivePath" ShowFullPath="true" /> }
                            <p>@task.SourceName · @task.Stage · @task.State @(task.IsHistorical ? "· Previous revision" : "")</p>
                            <p>Confirmed worker attempt elapsed at this sample: @PipelineFileExplorer.Elapsed(task.AttemptStartedAtUtc, activity.ObservedAtUtc).</p>
                            @if (task.PipelineRecordId is { } record) { <a href="@($"/corpus/{record}")">View pipeline record</a> }
                        </article>
                    }
                </div>
                <p class="status-freshness">Showing @runningTasks.Length task identities from a bounded app sample of at most 25; source filtering can exclude sampled rows.
                    @if (SelectedRoot is null) { <span>@activity.RunningTaskCount running pipeline, GPU-search and selected retained-processor tasks in total.</span> }
                    Worker heartbeat and GPU attempt timing are unavailable in these rows. Saved content progress is separate in file details.</p>
            }
            else if (view.RunningJobs > 0 || view.ActiveGpuTasks > 0 || view.Sources.Any(s => s.ActiveProcessors > 0))
            { <p>Running task identities are unavailable in this bounded sample or outside the selected source scope.</p> }
            else { <p>No file task has confirmed execution in this sample.</p> }
            <button type="button" @onclick='() => LoadFilesAsync(new("Pending", State: "Running"), SelectedRoot)'>View running source files</button>
        }
    </section>
    <section aria-labelledby="pending-stages-heading">
        <h2 id="pending-stages-heading">Where pending files are waiting</h2>
        @if (!activity.IsAvailable) { <p>File stage and OCR status unavailable. Zero pending files has not been confirmed.</p> }
        else
        {
            <p>Each pending logical file appears once, using its authoritative current record/stage and selected branch. Expand a file to inspect overlapping jobs.</p>
            <ul class="pending-stage-list">
                @foreach (var stage in stages.OrderBy(s => s.Stage).ThenBy(s => s.State))
                {
                    <li><button type="button" @onclick='() => LoadFilesAsync(new("Pending", stage.Stage, State: stage.State), SelectedRoot, stage.Count)'>@stage.Stage · @stage.State: @stage.Count.ToString("N0", CultureInfo.GetCultureInfo("en-GB")) files</button></li>
                }
            </ul>
            @if (stages.Sum(s => s.Count) != view.PendingFiles)
            { <p>Stage detail is unavailable for @(view.PendingFiles - stages.Sum(s => s.Count)) pending files in this sample.</p> }
            else if (view.PendingFiles == 0) { <p>No pending source files in this sample.</p> }
            <h3>Confirmed OCR demand</h3>
            @if (ocrDemand.Length == 0) { <p>OCR demand unavailable in this sample.</p> }
            else
            {
                <p>@ocrDemand.Sum(o => o.ConfirmedFiles) pending files have bound OCR requests; @ocrDemand.Sum(o => o.WaitingFiles) waiting and @ocrDemand.Sum(o => o.RunningFiles) running.
                    @if (ocrDemand.All(o => o.RequestedPages is not null)) { <span>@ocrDemand.Sum(o => o.RequestedPages) distinct requested pages are known for these files.</span> }
                    else { <span>Requested page total unavailable.</span> }</p>
                <p>@ocrDemand.Sum(o => o.DecisionUnconfirmedFiles) files await a confirmed OCR decision. Extraction status alone does not confirm OCR demand.</p>
            }
        }
    </section>
    <section aria-labelledby="index-health-heading">
        <h2 id="index-health-heading">Search-index health</h2>
        @if (ProjectionState.HasSnapshot)
        {
            <p><strong>@diagnostics.State</strong> · @diagnostics.Reason This describes the derived search index; source processing and historical outcomes are shown separately above.</p>
            <details class="diagnostic-details"><summary>Copyable index diagnostics</summary>
                @if (ProjectionState.Current.RuntimeObservedAtUtc is { } runtimeObserved)
                {
                    <p>Runtime recovery observed: @Time(runtimeObserved). This process observation is separate from the database sample.</p>
                }
                <label>Active generation <input class="diagnostic-value" readonly value="@diagnostics.ActiveGenerationDiagnostic" /></label>
                @if (diagnostics.RecoveryGenerationDiagnostic is { } recoveryGeneration)
                {
                    <label>Recovery generation <input class="diagnostic-value" readonly value="@recoveryGeneration" /></label>
                }
                <p>Recovery last completed: @Time(ProjectionState.Current.IndexRecovery.LastCompletedAtUtc).</p>
                <p>Recovery next retry: @Time(ProjectionState.Current.IndexRecovery.NextRetryAtUtc).</p>
                <p>Recovery cleaned candidates: @ProjectionState.Current.IndexRecovery.CleanedCandidateCount.</p>
            </details>
        }
        else { <p>Search-index status is unavailable.</p> }
    </section>
    <details class="diagnostic-details scheduler-details">
        <summary>Local GPU scheduler and retained totals</summary>
        @if (ProjectionState.HasSnapshot)
        {
        <p>Detailed read-only scheduler diagnostics. A pipeline job can own several GPU tasks.</p>
        <dl class="status-grid">
            <div><dt>Scheduler ready</dt><dd><StatusCount Value="scheduler.ReadyCount" /></dd></div>
            <div><dt>Scheduler active</dt><dd><StatusCount Value="scheduler.ActiveCount" /></dd></div>
            <div><dt>Scheduler deferred</dt><dd><StatusCount Value="scheduler.DeferredCount" /></dd></div>
            <div><dt>Scheduler outcome uncertain</dt><dd><StatusCount Value="scheduler.OutcomeUncertainCount" /></dd></div>
            <div><dt>Scheduler slots available</dt><dd>@scheduler.AvailableSlotCount</dd></div>
            <div><dt>Scheduler slots reserved</dt><dd>@scheduler.ReservedSlotCount</dd></div>
            <div><dt>Scheduler slots uncertain</dt><dd>@scheduler.UncertainSlotCount</dd></div>
            <div><dt>Scheduler active batch</dt><dd>@(scheduler.HasActiveBatch ? "Present" : "None")</dd></div>
            <div><dt>Scheduler next retry</dt><dd>@(scheduler.NextDeferredAtUtc?.ToString("O") ?? "None")</dd></div>
            <div><dt>Retained completed pipeline jobs</dt><dd><StatusCount Value="ProjectionState.Current.CompletedCount" /></dd></div>
            <div><dt>Retained failed pipeline jobs</dt><dd><StatusCount Value="ProjectionState.Current.FailedCount" /></dd></div>
            <div><dt>Completed retained pipeline records</dt><dd><StatusCount Value="ProjectionState.Current.IndexedRecordCount" /></dd></div>
        </dl>
        <p>Lifetime retained totals may change with source removal. They are not file progress.</p>
        <p>Outlook capture: @ProjectionState.Current.OutlookCapture.EnabledProfileCount enabled profiles; @ProjectionState.Current.OutlookCapture.IngestedCount ingested exports. <a href="/outlook">View Outlook capture</a></p>
        @if (activity.IsAvailable) { <p>Status read window: @Time(activity.ReadStartedAtUtc) to @Time(activity.ObservedAtUtc).</p> }
        }
        else { <p>Scheduler diagnostics are unavailable.</p> }
    </details>
</div>

@code {
    private readonly CancellationTokenSource _stopping = new();
    private StatusEventSubscription? _subscription;
    private Task? _observeTask;
    private Task? _timerTask;
    private string _announcement = "Loading pipeline status…";
    private string _sourceScope = "";
    private string _attentionUnit = "jobs";
    private string? _attentionReason;
    private bool _focusAttentionRecords;
    private ElementReference _attentionRecordsHeading;
    private PipelineAttentionPage? _attention;
    private string? _attentionError;
    private DateTimeOffset? _attentionReadAtUtc;
    private long _attentionRequest;
    private PipelineFileExplorer? _fileExplorer;
    private bool _filesOpen;
    private ElementReference _attentionHeading;
    private static PipelineFileFilter CurrentFiles(string category, string? reason = null) =>
        new(category, Reason: reason, Attention: PipelineFileAttentionScope.Current);
    private Task ShowIgnoredFilesAsync() => LoadFilesAsync(new(Attention: PipelineFileAttentionScope.Ignored), SelectedRoot);
    private async Task LoadFilesAsync(PipelineFileFilter filter, Guid? root, int? expected = null)
    {
        if (_fileExplorer is null) return;
        _filesOpen = true;
        StateHasChanged();
        await _fileExplorer.ShowAsync(filter, root, expected);
    }
    private async Task CloseFilesAsync()
    {
        _filesOpen = false;
        _fileExplorer?.ClearSelection();
        await _attentionHeading.FocusAsync();
    }
    private string AttentionPressed(string? reason) => _attentionReason == reason ? "true" : "false";
    private string AttentionRecordHeading => _attentionUnit switch
    {
        "current-jobs" => "Current indexing issues",
        "current-gpu" => "GPU work to verify",
        "historical-jobs" => "Previous indexing jobs",
        "historical-gpu" => "Previous GPU attempts",
        "jobs" => "Pipeline job records",
        _ => "GPU task records"
    };
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!_focusAttentionRecords) return;
        _focusAttentionRecords = false;
        if (_attention is not null) await _attentionRecordsHeading.FocusAsync();
    }
    private string AttentionScopeLabel => _attentionUnit.StartsWith("current-", StringComparison.Ordinal) ? "current issues" :
        _attentionUnit.StartsWith("historical-", StringComparison.Ordinal) ? "previous attempts" : "diagnostics";
    private static string FormatCount(int count, string unit) => count == 1 ? $"1 {unit}" : $"{count:N0} {unit}s";
    private static string? RecoveryExplanation(string reason) => reason switch
    {
        "index-storage-capacity-deferred" => "Publication is waiting for free index storage",
        "publication-snapshot-conflict" => "Publication will retry after the index changes settle",
        "embedding-gpu-retry" => "Embedding will retry from its saved progress",
        _ => null
    };
    private static string SourceIssueSummary(SourcePipelineProgress source) => source.UnconfirmedControls > 0
        ? "A scan or processor claim could not be confirmed. Check the source status before requesting new work."
        : source.ScanErrors > 0 ? "The last scan could not check every item. Review the access or availability problems." :
        "The source operation is waiting for a prerequisite. Review its last recorded step.";
    private static string IssueTitle(PipelineFileCauseGroup cause) => cause.Reason switch
    {
        "SourceContentNotAvailableLocally" or "SourceAccessContentUnavailable" or "source-content-not-available-locally" => "Files unavailable on this device",
        "CloudDirectoryNamespaceIncomplete" => "Some folders are unavailable on this device",
        "SourceInUse" => "Files are in use",
        "SourceAccessDenied" or "SourceAccessRepairNotApproved" or "SourceAccessExplicitDeny" => "Access to files needs review",
        "pdf-document-password-required" or "office-document-encrypted" => "Files need to be unlocked",
        "index-storage-capacity-deferred" => "Indexing is waiting for free space",
        "source-revision-binding-unconfirmed" => "File revisions need verification",
        _ when cause.Reason.StartsWith("document-ocr-", StringComparison.Ordinal) => "Text extraction needs review",
        _ when cause.Category == "Failed" => "File processing failed",
        _ => "File processing is blocked"
    };
    private Guid? SelectedRoot => Guid.TryParse(_sourceScope, out var id) ? id : null;
    private static string Time(DateTimeOffset? value) => value?.ToLocalTime().ToString("dd MMM yyyy HH:mm:ss zzz", CultureInfo.InvariantCulture) ?? "Not recorded";
    protected override async Task OnInitializedAsync()
    {
        GuidedActions.SubmissionsChanged += OnSubmissionsChanged;
        _subscription = await ProjectionState.SubscribeAndReloadAsync(StatusEvents, _stopping.Token);
        Announce();
        _observeTask = ObserveAsync(_subscription, _stopping.Token);
        _timerTask = RefreshPeriodicallyAsync(_stopping.Token);
    }
    private void OnSubmissionsChanged() => _ = InvokeAsync(StateHasChanged);
    private void Announce()
    {
        var view = PipelineActivityView.From(ProjectionState.Current.Activity, SelectedRoot);
        _announcement = ProjectionState.IsStale
            ? $"{ProjectionState.RefreshIssue} {(ProjectionState.HasSnapshot ? "The last successful read may be out of date." : "Current activity is unavailable; zero activity has not been confirmed.")}"
            : $"{view.State}. {view.Message}";
    }
    private async Task RefreshAsync()
    {
        await ProjectionState.ReloadAsync(_stopping.Token);
        await ApplyCurrentScopeAsync();
    }
    private async Task ApplyCurrentScopeAsync()
    {
        if (SelectedRoot is { } selected && !ProjectionState.Current.Activity.Sources.Any(s => s.Id == selected))
        {
            _sourceScope = "";
            await ScopeChangedAsync();
        }
        Announce();
    }
    private Task ScopeChangedAsync()
    {
        _attentionRequest++;
        _attention = null;
        _attentionReason = null;
        _focusAttentionRecords = false;
        _attentionReadAtUtc = null;
        _attentionError = null;
        _filesOpen = false;
        _fileExplorer?.ClearSelection();
        Announce();
        return Task.CompletedTask;
    }
    private async Task LoadAttentionAsync(string unit, int page, string? reason = null, bool focus = true)
    {
        var request = ++_attentionRequest;
        var root = SelectedRoot;
        var requestId = Guid.NewGuid();
        try
        {
            var result = await ProjectionReader.ReadPipelineAttentionAsync(unit, root, page, reason, _stopping.Token);
            if (request != _attentionRequest || root != SelectedRoot) return;
            _attention = result;
            _attentionReadAtUtc = DateTimeOffset.UtcNow;
            _attentionUnit = unit;
            _attentionReason = reason;
            _focusAttentionRecords = focus;
            _attentionError = null;
        }
        catch (Exception exception) when (exception is System.Data.Common.DbException or InvalidOperationException or TimeoutException)
        {
            AttentionLogger.LogWarning(exception,
                "Pipeline attention read {RequestId} failed for {Unit}, source {SourceRootId}, page {Page}.",
                requestId, unit, root, page + 1);
            if (request != _attentionRequest || root != SelectedRoot) return;
            _attentionError = "Attention records could not be refreshed. The summary and any previously loaded records may be out of date.";
        }
    }
    private async Task ObserveAsync(StatusEventSubscription subscription, CancellationToken cancellationToken)
    {
        try
        {
            await foreach (var changed in subscription.Reader.ReadAllAsync(cancellationToken))
            {
                var relevant = OverviewProjectionState.AffectsOverview(changed.Projection) || changed.Projection == "overview-snapshot";
                while (subscription.Reader.TryRead(out var pending))
                    relevant |= OverviewProjectionState.AffectsOverview(pending.Projection) || pending.Projection == "overview-snapshot";
                if (relevant) await InvokeAsync(async () =>
                {
                    if (ProjectionState.UsesSharedSnapshots) { ProjectionState.SynchronizeFromShared(); await ApplyCurrentScopeAsync(); }
                    else await RefreshAsync();
                    StateHasChanged();
                });
            }
        }
        catch (OperationCanceledException) when (cancellationToken.IsCancellationRequested) { }
    }
    private async Task RefreshPeriodicallyAsync(CancellationToken cancellationToken)
    {
        using var timer = new PeriodicTimer(TimeSpan.FromSeconds(ProjectionState.UsesSharedSnapshots ? 1 : 10));
        try
        {
            while (await timer.WaitForNextTickAsync(cancellationToken))
                await InvokeAsync(async () =>
                {
                    if (ProjectionState.UsesSharedSnapshots) { ProjectionState.SynchronizeFromShared(); await ApplyCurrentScopeAsync(); }
                    else await RefreshAsync();
                    StateHasChanged();
                });
        }
        catch (OperationCanceledException) when (cancellationToken.IsCancellationRequested) { }
    }
    public async ValueTask DisposeAsync()
    {
        GuidedActions.SubmissionsChanged -= OnSubmissionsChanged;
        await _stopping.CancelAsync();
        ProjectionState.ReleaseSharedSubscription();
        if (_subscription is not null) await _subscription.DisposeAsync();
        if (_observeTask is not null) await _observeTask;
        if (_timerTask is not null) await _timerTask;
        _stopping.Dispose();
    }
}
