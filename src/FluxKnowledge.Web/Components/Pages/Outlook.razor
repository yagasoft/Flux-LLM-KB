@page "/outlook"
@implements IDisposable
@using FluxKnowledge.Application.Contracts
@using FluxKnowledge.Application.IntegrationV1
@using FluxKnowledge.Application.Sources
@using FluxKnowledge.Domain.Outlook
@using FluxKnowledge.Web.Components.Outlook
@using Microsoft.JSInterop
@inject OutlookPageState PageState
@inject IJSRuntime JavaScriptRuntime
@inject IDeploymentValidationHold DeploymentHold
@inject TimeProvider Clock

<PageTitle>Outlook capture | Flux Knowledge</PageTitle>

<section aria-labelledby="outlook-heading">
    <h1 id="outlook-heading">Outlook capture</h1>
    <p>The local Outlook host verifies folders and captures mail from classic Outlook.</p>
    <p role="status" aria-live="polite">@_status</p>

    <p class="issue-actions"><button type="button" disabled="@_saving" @onclick="NewProfile">Add profile</button>
        <button type="button" @onclick="RefreshStatusAsync">Refresh capture status</button></p>

    @if (PageState.Projection.Profiles.Count == 0)
    {
        <p>No Outlook capture profiles are configured.</p>
    }
    else
    {
        @foreach (var profile in PageState.Projection.Profiles)
        {
            <article class="status-card" aria-labelledby="@($"outlook-profile-{profile.ProfileId:N}")">
                <h2 id="@($"outlook-profile-{profile.ProfileId:N}")">@profile.DisplayName</h2>
                <dl class="status-grid">
                    <div><dt>Capture state</dt><dd>@CaptureState(profile)</dd></div>
                    <div><dt>Incremental basis</dt><dd>@FormatBasis(profile.IncrementalBasis)</dd></div>
                    <div><dt>Schedule</dt><dd>Every @profile.Cadence.TotalMinutes.ToString("0") minutes</dd></div>
                    <div><dt>Overlap</dt><dd>@profile.MaximumOverlap.TotalMinutes.ToString("0") minutes</dd></div>
                    <div><dt>Spool</dt><dd>@profile.Spool.Status · @profile.Spool.Health · @profile.Spool.Capacity capacity</dd></div>
                    <div><dt>Created</dt><dd>@profile.CreatedAtUtc.LocalDateTime</dd></div>
                    <div><dt>Updated</dt><dd>@profile.UpdatedAtUtc.LocalDateTime</dd></div>
                    <div><dt>Last successful catch-up</dt><dd>@(profile.LastSuccessfulCatchUpAtUtc?.LocalDateTime.ToString() ?? "Not completed")</dd></div>
                    @if (profile.WatchedSourceRootId is { } watchedSourceRootId)
                    {
                        <div><dt>Last successful export</dt><dd>@(profile.LastSuccessfulExportAtUtc?.LocalDateTime.ToString() ?? "Not yet published")</dd></div>
                        <div><dt>Watched source</dt><dd><a href="@($"/sources/{watchedSourceRootId:D}")">Open source and indexing progress</a></dd></div>
                    }
                </dl>
                @if (profile.Verification?.Failure is { } failure)
                {
                    <p role="alert">@VerificationFailure(failure) Edit the profile to try again.</p>
                }
                @foreach (var warning in profile.Warnings)
                {
                    <p role="alert">@warning</p>
                }
                @if (profile.Folders.Count == 0)
                {
                    <p>No selected folders are currently available.</p>
                }
                else
                {
                    <div class="table-scroll">
                        <table>
                            <caption>Selected Outlook folders</caption>
                            <thead><tr><th>Folder</th><th>State</th><th>Cursor</th><th>Ingested</th><th>Deferred</th><th>Blocked</th></tr></thead>
                            <tbody>
                            @foreach (var folder in profile.Folders)
                            {
                                <tr>
                                    <td>@folder.DisplayName</td><td>@folder.State</td>
                                    <td>@(folder.CursorUtc?.LocalDateTime.ToString() ?? "Not captured")</td>
                                    <td>@folder.IngestedCount</td><td>@folder.DeferredCount</td><td>@folder.BlockedCount</td>
                                </tr>
                            }
                            </tbody>
                        </table>
                    </div>
                }
                <p>
                    <button type="button" disabled="@_saving" @onclick="() => EditProfile(profile)">Edit</button>
                    <button type="button" @onclick="() => PauseAsync(profile.ProfileId)">Pause</button>
                    <button type="button" @onclick="() => RemoveAsync(profile.ProfileId)">Remove</button>
                    @if (profile.State is not ("Disabled" or "Stale") && profile.Folders.Count > 0)
                    {
                        <button type="button" disabled="@(CatchUpLocked || _saving)" @onclick="() => ReviewCatchUp(profile, false)">Preview catch-up</button>
                        @if (profile.IncrementalBasis == OutlookIncrementalBasis.ReceivedTime)
                        {
                            <button type="button" disabled="@(CatchUpLocked || _saving)" @onclick="() => ReviewCatchUp(profile, true)">Preview overlap catch-up</button>
                        }
                    }
                </p>
            </article>
        }
    }

    @if (_pendingCatchUp is { } selection)
    {
        <section class="issue-inspector" aria-label="Outlook catch-up preview">
            <h3>@(selection.ReconcileMovedMessages ? "Catch up within the overlap window" : "Catch up")</h3>
            <p>Queue work for @selection.ProfileName. The Outlook companion uses the profile's configured folders, cursor and overlap when it claims the request.</p>
            @if (selection.ReconcileMovedMessages)
            {
                <p>Older moved messages outside that window can still be missed.</p>
            }
            @if (selection.Folders.Count > 0)
            {
                <details><summary>Folders selected in this preview (@selection.Folders.Count)</summary>
                    <ul>@foreach (var folder in selection.Folders) { <li>@folder.DisplayName</li> }</ul>
                </details>
            }
            <button type="button" disabled="@_submittingCatchUp" @onclick="ConfirmCatchUpAsync">@(_checkCatchUpReceipt ? "Check or retry the same request" : "Confirm request")</button>
            <button type="button" disabled="@CatchUpLocked" @onclick="() => _pendingCatchUp = null">Cancel</button>
        </section>
    }
    @if (_lastCatchUp is { } submitted)
    {
        <section aria-label="Catch-up progress">
            <h2>Catch-up progress</h2>
            <p>@submitted.ProfileName · <code>@submitted.OperationId</code></p>
            <p role="status">@(_catchUpProgress?.State ?? "Request accepted. Progress is unavailable in this sample.")
                @if (_catchUpProgress?.NextAttemptAtUtc is { } due) { <span>· Next attempt @due.ToLocalTime()</span> }</p>
            <button type="button" @onclick="RefreshCatchUpAsync">Refresh catch-up progress</button>
        </section>
    }

    @if (_showForm)
    {
        <section class="source-form" aria-labelledby="outlook-form-heading">
            <h2 id="outlook-form-heading">@(_editingProfileId is null ? "Add Outlook profile" : "Edit Outlook profile")</h2>
            @if (_editingProfileId is not null)
            {
                <p>Select a server-configured spool when saving. Private paths are never returned through UI projections or the interactive circuit.</p>
            }
            <EditForm Model="_formModel" OnSubmit="VerifyAndEnableAsync" FormName="outlook-profile">
                <label>Profile name <input @bind-value="_displayName" @bind-value:event="oninput" /></label>
                <label>Configured spool
                    <select @bind="_spoolConfigurationKey">
                        <option value="">Select a configured spool</option>
                        @foreach (var spool in PageState.SpoolChoices)
                        {
                            <option value="@spool.Key">@spool.DisplayName</option>
                        }
                    </select>
                </label>
                <label>Incremental basis
                    <select @bind="_basis">
                        <option value="@OutlookIncrementalBasis.LastModificationTime">Last modification time</option>
                        <option value="@OutlookIncrementalBasis.ReceivedTime">Received time</option>
                    </select>
                </label>
                @if (_basis == OutlookIncrementalBasis.ReceivedTime)
                {
                    <p role="alert">Received-time capture may miss older moved messages; use manual reconciliation when needed.</p>
                }
                <label>Cadence (minutes) <input type="number" min="5" max="1440" @bind="_cadenceMinutes" /></label>
                <label>Overlap (minutes) <input type="number" min="0" max="240" @bind="_overlapMinutes" /></label>
                <label>Exact Outlook folder path <input required maxlength="512" placeholder="Mailbox/Inbox/Folder" @key="_targetFolderPathInputGeneration" @ref="_targetFolderPathInput" autocomplete="off" /></label>
                <p>
                    <button type="submit" disabled="@_saving">Verify and enable</button>
                    <button type="button" @onclick="SaveDisabledAsync" disabled="@_saving">Save disabled</button>
                </p>
            </EditForm>
        </section>
    }
</section>

@code {
    private sealed class FormModel;
    private readonly FormModel _formModel = new();
    private CancellationTokenSource _stopping = new();
    private bool _showForm;
    private Guid? _editingProfileId;
    private long _configurationRevision = 1;
    private string _displayName = string.Empty;
    private string _spoolConfigurationKey = string.Empty;
    private OutlookIncrementalBasis _basis = OutlookIncrementalBasis.LastModificationTime;
    private int _cadenceMinutes = 15;
    private int _overlapMinutes = 2;
    private ElementReference _targetFolderPathInput;
    private long _targetFolderPathInputGeneration;
    private bool _saving;
    private bool _watchingVerification;
    private string _status = "Loading Outlook capture status from SQL…";
    private CatchUpSelection? _pendingCatchUp;
    private CatchUpSelection? _lastCatchUp;
    private OutlookCatchUpStatus? _catchUpProgress;
    private bool _submittingCatchUp;
    private bool _checkCatchUpReceipt;
    private bool CatchUpLocked => _submittingCatchUp || _checkCatchUpReceipt;
    private sealed record CatchUpSelection(Guid OperationId, Guid ProfileId, string ProfileName, long ConfigurationRevision,
        IReadOnlyList<OutlookFolderStatusProjection> Folders, bool ReconcileMovedMessages, DateTimeOffset ExpiresAtUtc);

    protected override async Task OnInitializedAsync()
    {
        await PageState.ReloadAsync(_stopping.Token);
        _status = "Outlook capture status loaded from SQL.";
        WatchPendingVerification();
    }

    private void NewProfile()
    {
        if (_saving) return;
        _showForm = true;
        _editingProfileId = null;
        _configurationRevision = 1;
        _displayName = string.Empty;
        _spoolConfigurationKey = PageState.SpoolChoices.FirstOrDefault()?.Key ?? string.Empty;
        _basis = OutlookIncrementalBasis.LastModificationTime;
        _cadenceMinutes = 15;
        _overlapMinutes = 2;
        _targetFolderPathInputGeneration++;
    }

    private void EditProfile(OutlookProfileStatusProjection profile)
    {
        if (_saving) return;
        _showForm = true;
        _editingProfileId = profile.ProfileId;
        _configurationRevision = profile.ConfigurationRevision;
        _displayName = profile.DisplayName;
        _spoolConfigurationKey = profile.Spool.ConfigurationKey ?? string.Empty;
        _basis = profile.IncrementalBasis;
        _cadenceMinutes = checked((int)profile.Cadence.TotalMinutes);
        _overlapMinutes = checked((int)profile.MaximumOverlap.TotalMinutes);
        _targetFolderPathInputGeneration++;
    }

    private Task VerifyAndEnableAsync(EditContext _) => SubmitProfileAsync(verify: true);

    private Task SaveDisabledAsync() => SubmitProfileAsync(verify: false);

    private async Task SubmitProfileAsync(bool verify)
    {
        if (_saving) return;
        _saving = true;
        var draft = BuildDraft();
        try
        {
            await RunMutationAsync(async () =>
            {
                if (verify)
                {
                    var targetPath = await ReadAndClearTargetFolderPathAsync();
                    if (string.IsNullOrWhiteSpace(targetPath))
                    {
                        _status = "Enter the exact Outlook folder path, including the mailbox name.";
                        return;
                    }
                    await PageState.VerifyAndEnableAsync(draft with { TargetFolderPath = targetPath }, _stopping.Token);
                    _showForm = false;
                    _status = "Verification requested. The profile enables automatically once the Outlook host verifies the folder.";
                    try
                    {
                        await PageState.ReloadAsync(_stopping.Token);
                    }
                    catch (Exception) when (!_stopping.IsCancellationRequested)
                    {
                        _status = "Verification was requested. Reload the page to check its status.";
                    }
                }
                else
                {
                    await PageState.SaveAsync(draft, _stopping.Token);
                    _status = "Profile saved disabled.";
                }
                _showForm = false;
                WatchPendingVerification();
            });
        }
        finally
        {
            _saving = false;
        }
    }

    private void WatchPendingVerification()
    {
        if (!_watchingVerification && HasPendingVerification())
        {
            _ = RefreshPendingVerificationAsync(_stopping.Token);
        }
    }

    private bool HasPendingVerification() =>
        PageState.Projection.Profiles.Any(profile => profile.Verification?.IsPending == true);

    private async Task RefreshPendingVerificationAsync(CancellationToken cancellationToken)
    {
        _watchingVerification = true;
        using var timer = new PeriodicTimer(TimeSpan.FromSeconds(10));
        try
        {
            while (HasPendingVerification() && await timer.WaitForNextTickAsync(cancellationToken))
            {
                if (_saving) continue;
                await PageState.ReloadAsync(cancellationToken);
                if (!HasPendingVerification()) _status = "Outlook folder verification finished. See the profile status below.";
                StateHasChanged();
            }
        }
        catch (OperationCanceledException) when (cancellationToken.IsCancellationRequested) { }
        catch (Exception) when (!cancellationToken.IsCancellationRequested)
        {
            _status = "Outlook status could not be refreshed. Reload this page to check verification.";
            StateHasChanged();
        }
        finally
        {
            _watchingVerification = false;
        }
    }

    private static string CaptureState(OutlookProfileStatusProjection profile) => profile.Verification switch
    {
        { IsPending: true } => "Waiting for Outlook",
        { Failure: not null } => "Verification failed",
        _ when profile.State == nameof(OutlookCaptureState.AwaitingHost) => "Enabled",
        _ => profile.State
    };

    private static string VerificationFailure(OutlookBrowseFailureCode failure) => failure switch
    {
        OutlookBrowseFailureCode.Expired => "The Outlook host did not verify the folder within 24 hours.",
        OutlookBrowseFailureCode.AccessDenied => "Classic Outlook denied access to the folder.",
        OutlookBrowseFailureCode.HostUnavailable => "The Outlook host could not access classic Outlook.",
        _ => "The Outlook host could not verify the folder. Check the mailbox and folder names."
    };

    private async Task PauseAsync(Guid profileId) => await RunMutationAsync(async () =>
    {
        await PageState.PauseAsync(new OutlookCaptureProfileId(profileId), _stopping.Token);
        _status = "Profile paused in SQL. No new host claim is eligible.";
    });

    private async Task RemoveAsync(Guid profileId) => await RunMutationAsync(async () =>
    {
        await PageState.RemoveAsync(new OutlookCaptureProfileId(profileId), _stopping.Token);
        _status = "Profile removed from active capture configuration.";
    });

    private async Task RefreshStatusAsync() => await RunMutationAsync(async () =>
    {
        await PageState.ReloadAsync(_stopping.Token);
        _status = "Current Outlook capture status loaded.";
    });

    private void ReviewCatchUp(OutlookProfileStatusProjection profile, bool reconcileMovedMessages)
    {
        if (CatchUpLocked) return;
        if (DeploymentHold.IsHeld)
        {
            _status = "Deployment validation is holding catch-up requests. Check again after it finishes.";
            return;
        }
        _pendingCatchUp = new(Guid.NewGuid(), profile.ProfileId, profile.DisplayName, profile.ConfigurationRevision,
            profile.Folders.ToArray(), reconcileMovedMessages, Clock.GetUtcNow().AddMinutes(2));
    }

    private async Task ConfirmCatchUpAsync()
    {
        if (_submittingCatchUp || _pendingCatchUp is not { } selection) return;
        if (!_checkCatchUpReceipt && selection.ExpiresAtUtc <= Clock.GetUtcNow())
        {
            _pendingCatchUp = null;
            _status = "The preview expired. Review the current profile and prepare a new request.";
            return;
        }
        _submittingCatchUp = true;
        try
        {
            var receipt = await PageState.RequestCatchUpAsync(new(selection.ProfileId), selection.ReconcileMovedMessages,
                _stopping.Token, selection.OperationId, selection.ConfigurationRevision,
                selection.Folders.Select(folder => folder.FolderId).ToArray(), selection.ExpiresAtUtc);
            if (!receipt.Committed)
            {
                _checkCatchUpReceipt = true;
                _status = "The request was not confirmed. Check or retry the same request.";
                return;
            }
            _checkCatchUpReceipt = false;
            _pendingCatchUp = null;
            _status = receipt.Accepted
                ? "Catch-up requested. Follow this request in Catch-up progress."
                : "The profile or its folders changed after the preview. Review the current settings.";
            if (receipt.Accepted)
            {
                _lastCatchUp = selection;
                _catchUpProgress = null;
                await RefreshCatchUpAsync();
            }
        }
        catch (OperationCanceledException) when (_stopping.IsCancellationRequested) { }
        catch (UnauthorizedAccessException)
        {
            _status = "A local operator connection is required to submit or check a catch-up request.";
        }
        catch (NativeOperationException exception) when (exception.ReasonCode == "deployment-validation-held")
        {
            _status = "Deployment validation is holding catch-up requests. Check again after it finishes.";
        }
        catch (NativeOperationException exception) when (exception.ReasonCode == "confirmation-expired")
        {
            _checkCatchUpReceipt = false;
            _pendingCatchUp = null;
            _status = "The preview expired. Review the current profile and prepare a new request.";
        }
        catch (Exception exception)
        {
            _checkCatchUpReceipt = true;
            _status = OutlookPageState.ToSafeOperatorMessage(exception);
        }
        finally { _submittingCatchUp = false; }
    }

    private async Task RefreshCatchUpAsync()
    {
        if (_lastCatchUp is not { } submitted) return;
        await RunMutationAsync(async () =>
        {
            var progress = await PageState.ReadCatchUpAsync(submitted.ProfileId, submitted.OperationId, _stopping.Token);
            if (_lastCatchUp?.OperationId == submitted.OperationId) _catchUpProgress = progress;
        });
    }

    private async Task RunMutationAsync(Func<Task> mutation)
    {
        try
        {
            await mutation();
        }
        catch (OperationCanceledException) when (_stopping.IsCancellationRequested)
        {
            _status = "Outlook operation cancelled.";
        }
        catch (Exception exception)
        {
            _status = OutlookPageState.ToSafeOperatorMessage(exception);
        }
    }

    private OutlookProfileDraft BuildDraft() => new(
        _editingProfileId is { } id ? new OutlookCaptureProfileId(id) : null,
        _displayName,
        _spoolConfigurationKey,
        _basis,
        new OutlookCaptureSchedule(TimeSpan.FromMinutes(_cadenceMinutes), TimeSpan.FromMinutes(_overlapMinutes)),
        false,
        _configurationRevision);

    private ValueTask<string> ReadAndClearTargetFolderPathAsync() =>
        JavaScriptRuntime.InvokeAsync<string>("fluxKnowledge.outlook.readAndClearTargetPath", _targetFolderPathInput);

    private static string FormatBasis(OutlookIncrementalBasis basis) => basis switch
    {
        OutlookIncrementalBasis.LastModificationTime => "Last modification time",
        OutlookIncrementalBasis.ReceivedTime => "Received time",
        _ => "Unknown"
    };

    public void Dispose()
    {
        _stopping.Cancel();
        _stopping.Dispose();
    }
}
