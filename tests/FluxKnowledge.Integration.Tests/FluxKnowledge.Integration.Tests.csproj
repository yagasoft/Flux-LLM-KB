<Project Sdk="Microsoft.NET.Sdk">
  <ItemGroup>
    <ProjectReference Include="../../src/FluxKnowledge.Infrastructure.SqlServer/FluxKnowledge.Infrastructure.SqlServer.csproj" />
    <ProjectReference Include="../../src/FluxKnowledge.Infrastructure.Usearch/FluxKnowledge.Infrastructure.Usearch.csproj" />
    <ProjectReference Include="../../src/FluxKnowledge.Infrastructure.Inference/FluxKnowledge.Infrastructure.Inference.csproj" />
    <ProjectReference Include="../../src/FluxKnowledge.Integrations/FluxKnowledge.Integrations.csproj" />
    <ProjectReference Include="../../src/FluxKnowledge.Cli/FluxKnowledge.Cli.csproj" />
    <ProjectReference Include="../../src/FluxKnowledge.DeterministicWorker/FluxKnowledge.DeterministicWorker.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <Target Name="CopyDeterministicWorkerOutput" AfterTargets="Build">
    <PropertyGroup>
      <DeterministicWorkerOutputDirectory>$(ArtifactsPath)bin\FluxKnowledge.DeterministicWorker\$([System.String]::Copy('$(Configuration)').ToLowerInvariant())</DeterministicWorkerOutputDirectory>
    </PropertyGroup>
    <ItemGroup>
      <_DeterministicWorkerOutput Include="$(DeterministicWorkerOutputDirectory)\**\*" />
    </ItemGroup>
    <Copy SourceFiles="@(_DeterministicWorkerOutput)" DestinationFiles="@(_DeterministicWorkerOutput->'$(OutDir)deterministic-worker\%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
  </Target>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" PrivateAssets="all" />
  </ItemGroup>
</Project>
